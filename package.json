{
  "name": "@undsky/wtui",
  "version": "0.1.1",
  "description": "Git Worktree Visual Platform.Parallel development with multiple AI tools, one-click merge, and AI-powered conflict resolution.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wtui": "./bin/wt-ui.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/"
  ],
  "scripts": {
    "start": "node bin/wt-ui.js start",
    "doctor": "node bin/wt-ui.js doctor",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "worktrunk",
    "git",
    "worktree",
    "ui",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "monaco-editor": "^0.57.0"
  }
}
